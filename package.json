{
  "name": "dandelion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config src-fe/vite.config.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --config src-fe/vite.config.ts",
    "test:unit": "vitest -c src-fe/vitest.config.ts",
    "test:e2e": "playwright test -c src-fe/playwright.config.ts",
    "build-only": "vite build --config src-fe/vite.config.ts",
    "type-check": "vue-tsc --build src-fe --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src-fe/src/",
    "tauri": "tauri",
    "clean": "sh ./clean.sh"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "element-plus": "^2.13.6",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "prettier-v2": "npm:prettier@2.8.8",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tauri-apps/cli": "^2.10.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.7",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}