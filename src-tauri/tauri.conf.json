{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dandelion",
  "version": "0.0.1",
  "identifier": "com.dandelion",
  "build": {
    "frontendDist": "../ui-vue/dist",
    "devUrl": "http://localhost:21431",
    "beforeDevCommand": "bun -F ui-vue dev",
    "beforeBuildCommand": "bun -F ui-vue build"
  },
  "app": {
    "windows": [
      {
        "title": "dandelion",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
